{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@core/*": ["./src/core/*"],
      "@componentes/*": ["./src/core/componentes/*"],
      "@layouts/*": ["./src/core/layouts/*"],
      "@wicss/*": ["./src/core/wicss/*"],
      "@servicios/*": ["./src/core/servicios/*"],
      "@widev": ["./src/core/widev/widev.js"],
      "@widev/*": ["./src/core/widev/*"],
      "@semillas": ["./src/semillas/configurar.js"],
      "@semillas/*": ["./src/semillas/*"],
      "@feature/*": ["./src/feature/*"],
      "@wii": ["./src/wii.js"]
    }
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"]
}
