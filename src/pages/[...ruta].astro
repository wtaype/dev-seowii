---
// src/pages/[...ruta].astro
// ⭐ Enrutador único bilingüe: genera todas las rutas en ES (/) y EN (/en/...)
import Principal from '@layouts/Principal.astro';
import GeneralPage from '@feature/general/GeneralPage.astro';
import ImgwiiPage from '@feature/imgwii/ImgwiiPage.astro';
import LectorJsonPage from '@feature/lector-json/LectorJsonPage.astro';
import LectorMdPage from '@feature/lector-md/LectorMdPage.astro';
import SeoTestPage from '@feature/seo-test/SeoTestPage.astro';
import SpeedTestPage from '@feature/speed-test/SpeedTestPage.astro';
import AjustesPage from '@feature/ajustes/AjustesPage.astro';
import { LISTA_IDIOMAS, buildRuta, getCoreLang, type Idioma } from '@idioma';

export function getStaticPaths() {
  const modulos = [
    { id: 'general', href: '/' },
    { id: 'imgwii', href: '/imgwii' },
    { id: 'lector-json', href: '/lector-json' },
    { id: 'lector-md', href: '/lector-md' },
    { id: 'seo-test', href: '/seo-test' },
    { id: 'speed-test', href: '/speed-test' },
    { id: 'ajustes', href: '/ajustes' }
  ];

  return modulos.flatMap((mod) =>
    LISTA_IDIOMAS.map(({ code }) => {
      const slug = buildRuta(mod.href, code).replace(/^\//, '');
      return {
        params: { ruta: slug || undefined },
        props: { idioma: code as Idioma, modulo: mod.id }
      };
    })
  );
}

const { idioma, modulo } = Astro.props;
const t = getCoreLang(idioma);
const label = t.nav?.[modulo]?.label || t.util?.[modulo] || modulo;
const titulo = `dev.seowii.com — ${label}`;
---

<Principal idioma={idioma} titulo={titulo}>
  {modulo === 'general' && (
    <>
      <GeneralPage idioma={idioma} />
      <script>
        import '@feature/general/general.js';
      </script>
    </>
  )}

  {modulo === 'imgwii' && (
    <>
      <ImgwiiPage idioma={idioma} />
      <script>
        import '@feature/imgwii/imgwii.js';
      </script>
    </>
  )}

  {modulo === 'lector-json' && (
    <>
      <LectorJsonPage idioma={idioma} />
      <script>
        import '@feature/lector-json/lector-json.js';
      </script>
    </>
  )}

  {modulo === 'lector-md' && (
    <>
      <LectorMdPage idioma={idioma} />
      <script>
        import '@feature/lector-md/lector-md.js';
      </script>
    </>
  )}

  {modulo === 'seo-test' && (
    <>
      <SeoTestPage idioma={idioma} />
      <script>
        import '@feature/seo-test/seo-test.js';
      </script>
    </>
  )}

  {modulo === 'speed-test' && (
    <>
      <SpeedTestPage idioma={idioma} />
      <script>
        import '@feature/speed-test/speed-test.js';
      </script>
    </>
  )}

  {modulo === 'ajustes' && (
    <>
      <AjustesPage idioma={idioma} />
      <script>
        import '@feature/ajustes/ajustes.js';
      </script>
    </>
  )}
</Principal>
