---
// src/pages/[...ruta].astro
// ⭐ Enrutador único bilingüe: genera todas las rutas en ES (/) y EN (/en/...)
import Principal from '@layouts/Principal.astro';
import GeneralPage from '@feature/general/GeneralPage.astro';
import { LISTA_IDIOMAS, buildRuta, getCoreLang, type Idioma } from '@idioma';

export function getStaticPaths() {
  return LISTA_IDIOMAS.map(({ code }) => {
    const slug = buildRuta('/', code).replace(/^\//, '');
    return {
      params: { ruta: slug || undefined },
      props: { idioma: code as Idioma, modulo: 'general' }
    };
  });
}

const { idioma } = Astro.props;
const t = getCoreLang(idioma);
---

<Principal idioma={idioma} titulo={`dev.seowii.com — ${t.nav?.general?.label || 'General'}`}>
  <GeneralPage idioma={idioma} />
  <script>
    import '@feature/general/general.js';
  </script>
</Principal>
