---
// src/pages/[...ruta].astro
// ⭐ Enrutador único bilingüe — Genera todas las rutas en ES (/) y EN (/en/...)
import Principal from '@layouts/Principal.astro';
import GeneralPage from '@feature/general/GeneralPage.astro';
import ImgwiiPage from '@feature/imgwii/ImgwiiPage.astro';
import LectorJsonPage from '@feature/lector-json/LectorJsonPage.astro';
import LectorMdPage from '@feature/lector-md/LectorMdPage.astro';
import SeoTestPage from '@feature/seo-test/SeoTestPage.astro';
import SpeedTestPage from '@feature/speed-test/SpeedTestPage.astro';
import AjustesPage from '@feature/ajustes/AjustesPage.astro';
import AprenderPage from '@feature/aprender/AprenderPage.astro';
import AcercasPage from '@feature/acercas/AcercasPage.astro';
import { app } from '@wii';
import { configurar } from '@semillas/configurar.js';
import { LISTA_IDIOMAS, buildRuta, getCoreLang, type Idioma } from '@idioma';

// Genera las rutas estáticas por cada módulo y cada idioma soportado en LISTA_IDIOMAS
export function getStaticPaths() {
  // Las 6 rutas de Acerca vienen directo de configurar.enlacesAcerca (1 sola fuente de verdad)
  const modulos = [
    { id: 'general', href: '/' },
    { id: 'imgwii', href: '/imgwii' },
    { id: 'lector-json', href: '/lector-json' },
    { id: 'lector-md', href: '/lector-md' },
    { id: 'seo-test', href: '/seo-test' },
    { id: 'speed-test', href: '/speed-test' },
    { id: 'ajustes', href: '/ajustes' },
    { id: 'aprender', href: '/aprender' },
    { id: 'mas', href: '/mas' },
    ...configurar.enlacesAcerca.map(({ id, href }) => ({ id, href }))
  ];

  return modulos.flatMap(({ id, href }) =>
    LISTA_IDIOMAS.map(({ code }) => ({
      params: { ruta: buildRuta(href, code).replace(/^\//, '') || undefined },
      props: { idioma: code as Idioma, modulo: id }
    }))
  );
}

// Mapa de módulos principales (los de Acerca caen automático en AcercasPage)
const PAGES: Record<string, any> = {
  general: GeneralPage,
  imgwii: ImgwiiPage,
  'lector-json': LectorJsonPage,
  'lector-md': LectorMdPage,
  'seo-test': SeoTestPage,
  'speed-test': SpeedTestPage,
  ajustes: AjustesPage,
  aprender: AprenderPage
};

// Resuelve idioma, título dinámico desde @wii y componente activo de la ruta actual
const { idioma, modulo } = Astro.props;
const t = getCoreLang(idioma);
const label = t.nav?.[modulo]?.label || t.util?.[modulo] || t.acerca?.enlaces?.[modulo] || modulo;
const titulo = `${app} — ${label}`;
const Page = PAGES[modulo] || AcercasPage;
const scriptModulo = PAGES[modulo] ? modulo : 'acercas';
---

<Principal idioma={idioma} titulo={titulo}>
  {/* Contenedor neutro (display:contents) para identificar el módulo activo sin alterar el layout */}
  <div id="dvModuloRoot" data-modulo={scriptModulo} style="display:contents">
    <Page idioma={idioma} seccion={modulo} />
  </div>

  {/* Carga dinámica bajo demanda del script cliente de cada feature (../feature/<mod>/<mod>.js) */}
  <script>
    const scripts = import.meta.glob('../feature/*/*.js');
    const cargarModulo = () => {
      const mod = document.getElementById('dvModuloRoot')?.dataset.modulo;
      const ruta = mod ? `../feature/${mod}/${mod}.js` : '';
      if (ruta && scripts[ruta]) scripts[ruta]();
    };
    cargarModulo();
    document.addEventListener('astro:page-load', cargarModulo);
  </script>
</Principal>
