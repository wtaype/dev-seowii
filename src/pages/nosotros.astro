---
import Principal from '@core/layouts/Principal.astro';
import Nosotros from '@feature/acercas/secciones/Nosotros.astro';
import { tAcercas } from '@feature/acercas/idioma/idioma.js';
import { app } from '@semillas';

const idioma = 'es';
const t = tAcercas('nosotros', idioma);
---

<Principal titulo={`${t.page_title} · ${app}`} descripcion={t.desc}>
  <Nosotros idioma={idioma} />
</Principal>
