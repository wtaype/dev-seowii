---
import Principal from '@core/layouts/Principal.astro';
import Contacto from '@feature/acercas/secciones/Contacto.astro';
import { tAcercas } from '@feature/acercas/idioma/idioma.js';

const idioma = 'es';
const t = tAcercas('contacto', idioma);
---

<Principal titulo={t.page_title} descripcion={t.desc} idioma={idioma} feature="inicio">
  <Contacto idioma={idioma} />
</Principal>
