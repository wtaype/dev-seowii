---
// src/feature/acercas/secciones/LibroReclamaciones.astro
// 📖 Libro de Reclamaciones Virtual — Wizard 5 Pasos (INDECOPI · Ley N° 29571 · Ley N° 31435)

import { app } from '@semillas';
const datosApp: Record<string, any> = {};
type Idioma = 'es' | 'en' | 'pt';
import { tAcercas } from '../idioma/idioma.js';
import '../acercas.css';

interface Props {
  idioma?: Idioma;
}

const { idioma = 'es' } = Astro.props;
const t = tAcercas('reclamaciones', idioma);

const marcaApp = (datosApp.marca || {}) as Record<string, any>;
const contactoApp = (datosApp.contacto || {}) as Record<string, any>;

const nombreMarca = marcaApp.nombre || app.marca?.nombre || '';
const razonSocial = marcaApp.razonSocial || app.marca?.razonSocial || nombreMarca;
const sede = contactoApp.sedePrincipal || app.contacto?.sedePrincipal || '';
const correo = contactoApp.correo || app.contacto?.correo || '';
const cel =
  contactoApp.celular ||
  contactoApp.whatsapp ||
  contactoApp.telefono ||
  app.contacto?.celular ||
  app.contacto?.whatsapp ||
  app.contacto?.telefono ||
  '';

const pasos = [
  { num: 1, lbl: t.step1_short },
  { num: 2, lbl: t.step2_short },
  { num: 3, lbl: t.step3_short },
  { num: 4, lbl: t.step4_short },
  { num: 5, lbl: t.step5_short },
];
const faqItems = Array.isArray(t.faq_items) ? t.faq_items : [];
---

<section class="acercas-page-wrap" aria-label={t.page_title || 'Libro de Reclamaciones'}>
  <div class="conwii">
    <header class="acercas-hero-header">
      {t.badge && <div class="acercas-badge-pill">{t.badge}</div>}
      <h1 class="acercas-hero-title">
        {t.titulo_start} {t.titulo_highlight && <span>{t.titulo_highlight}</span>}
      </h1>
      {t.desc && <p class="acercas-hero-desc">{t.desc}</p>}
    </header>

    <div class="reclamos-proveedor-card">
      <div class="reclamos-prov-header">
        <i class="fa-solid fa-building-shield" aria-hidden="true"></i>
        <span>{t.prov_tit}</span>
      </div>
      <div class="reclamos-prov-grid">
        <div class="reclamos-prov-item">
          <span class="reclamos-prov-lbl">{t.prov_razon}</span>
          <span class="reclamos-prov-val">{razonSocial}</span>
        </div>
        <div class="reclamos-prov-item">
          <span class="reclamos-prov-lbl">{t.prov_sede}</span>
          <span class="reclamos-prov-val">{sede}</span>
        </div>
        <div class="reclamos-prov-item">
          <span class="reclamos-prov-lbl">{t.prov_correo}</span>
          <span class="reclamos-prov-val">{correo}</span>
        </div>
        <div class="reclamos-prov-item">
          <span class="reclamos-prov-lbl">{t.prov_canal}</span>
          <span class="reclamos-prov-val">{cel}</span>
        </div>
      </div>
    </div>

    <div class="acercas-form-card">
      <nav class="reclamos-stepper" id="reclamosStepper" aria-label="Progreso">
        {pasos.map((p, i) => (
          <div class={`reclamos-step-item ${i === 0 ? 'is-active' : ''}`} data-step-indicator={p.num}>
            <span class="reclamos-step-num" data-num={p.num}>0{p.num}</span>
            <span class="reclamos-step-lbl">{p.lbl}</span>
          </div>
        ))}
      </nav>

      <form
        id="formLibroReclamaciones"
        data-cel={cel}
        data-watpl={t.wa_tpl || ''}
        data-res-consumidor={t.res_consumidor}
        data-res-bien={t.res_bien}
        data-res-reclamo={t.res_reclamo}
      >
        <div class="reclamos-step-panel is-active" data-step="1">
          <fieldset class="reclamos-step-fieldset">
            <legend class="reclamos-step-legend">
              <i class="fa-solid fa-user-check" aria-hidden="true"></i>
              <span>{t.paso1_tit}</span>
            </legend>
            <div class="acercas-form-grid">
              <div class="acercas-field is-full">
                <label for="recNombre">{t.lbl_nombre}</label>
                <input id="recNombre" name="nombre" class="acercas-input" type="text" required placeholder={t.ph_nombre} />
              </div>

              <div class="acercas-field">
                <label for="recTipoDoc">{t.lbl_tipo_doc}</label>
                <select id="recTipoDoc" name="tipoDoc" class="acercas-select" required>
                  <option value="DNI">DNI</option>
                  <option value="CE">Carnet de Extranjería (CE)</option>
                  <option value="Pasaporte">Pasaporte</option>
                  <option value="RUC">RUC</option>
                </select>
              </div>

              <div class="acercas-field">
                <label for="recDocumento">{t.lbl_doc}</label>
                <input id="recDocumento" name="documento" class="acercas-input" type="text" required placeholder={t.ph_doc} />
              </div>

              <div class="acercas-field">
                <label for="recTelefono">{t.lbl_tel}</label>
                <input id="recTelefono" name="telefono" class="acercas-input" type="tel" required placeholder={cel} />
              </div>

              <div class="acercas-field">
                <label for="recCorreo">{t.lbl_correo}</label>
                <input id="recCorreo" name="correo" class="acercas-input" type="email" required placeholder={t.ph_correo} />
              </div>

              <div class="acercas-field is-full">
                <label for="recDireccion">{t.lbl_direccion}</label>
                <input id="recDireccion" name="direccion" class="acercas-input" type="text" required placeholder={t.ph_direccion} />
              </div>

              <div class="acercas-field is-full">
                <label class="reclamos-check-row" for="recMenorCheck">
                  <input id="recMenorCheck" name="esMenor" type="checkbox" />
                  <span>{t.lbl_menor}</span>
                </label>
              </div>

              <div class="acercas-field is-full reclamos-hidden" id="recTutorGroup">
                <label for="recTutor">{t.lbl_tutor}</label>
                <input id="recTutor" name="tutor" class="acercas-input" type="text" placeholder={t.ph_tutor} />
              </div>
            </div>
          </fieldset>

          <div class="reclamos-wizard-nav is-end">
            <button type="button" class="reclamos-btn-next" data-next="2">
              <span>{t.btn_siguiente}</span>
              <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
            </button>
          </div>
        </div>

        <div class="reclamos-step-panel" data-step="2">
          <fieldset class="reclamos-step-fieldset">
            <legend class="reclamos-step-legend">
              <i class="fa-solid fa-layer-group" aria-hidden="true"></i>
              <span>{t.paso2_tit}</span>
            </legend>
            <div class="acercas-form-grid">
              <div class="acercas-field">
                <label for="recBienTipo">{t.lbl_bien_tipo}</label>
                <select id="recBienTipo" name="bienTipo" class="acercas-select" required>
                  <option value="Servicio">{t.opt_servicio}</option>
                  <option value="Asesoria">{t.opt_asesoria}</option>
                  <option value="Producto">{t.opt_producto}</option>
                </select>
              </div>

              <div class="acercas-field">
                <label for="recMonto">{t.lbl_moneda}</label>
                <div class="reclamos-money-row">
                  <select id="recMoneda" name="moneda" class="acercas-select" aria-label="Moneda">
                    <option value="PEN">PEN (S/)</option>
                    <option value="USD">USD ($)</option>
                  </select>
                  <input id="recMonto" name="monto" class="acercas-input" type="number" step="0.01" min="0" placeholder={t.ph_monto} />
                </div>
              </div>

              <div class="acercas-field is-full">
                <label for="recServicio">{t.lbl_servicio}</label>
                <input id="recServicio" name="servicio" class="acercas-input" type="text" required placeholder={t.ph_servicio} />
              </div>
            </div>
          </fieldset>

          <div class="reclamos-wizard-nav">
            <button type="button" class="reclamos-btn-prev" data-prev="1">
              <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
              <span>{t.btn_anterior}</span>
            </button>
            <button type="button" class="reclamos-btn-next" data-next="3">
              <span>{t.btn_siguiente}</span>
              <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
            </button>
          </div>
        </div>

        <div class="reclamos-step-panel" data-step="3">
          <fieldset class="reclamos-step-fieldset">
            <legend class="reclamos-step-legend">
              <i class="fa-solid fa-file-circle-exclamation" aria-hidden="true"></i>
              <span>{t.paso3_tit}</span>
            </legend>
            <div class="acercas-form-grid">
              <div class="acercas-field is-full">
                <label>{t.lbl_tipo_rec}</label>
                <div class="reclamos-radio-grid">
                  <label class="reclamos-radio-card">
                    <input type="radio" name="tipoReclamo" value="Reclamo" checked />
                    <span>
                      <span class="reclamos-radio-title">{t.rec_titulo}</span>
                      <span class="reclamos-radio-desc">{t.rec_desc}</span>
                    </span>
                  </label>
                  <label class="reclamos-radio-card">
                    <input type="radio" name="tipoReclamo" value="Queja" />
                    <span>
                      <span class="reclamos-radio-title">{t.que_titulo}</span>
                      <span class="reclamos-radio-desc">{t.que_desc}</span>
                    </span>
                  </label>
                </div>
              </div>

              <div class="acercas-field is-full">
                <label for="recDetalle">{t.lbl_detalle}</label>
                <textarea id="recDetalle" name="detalle" class="acercas-textarea" rows="4" required placeholder={t.ph_detalle}></textarea>
              </div>

              <div class="acercas-field is-full">
                <label for="recPedido">{t.lbl_pedido}</label>
                <textarea id="recPedido" name="pedido" class="acercas-textarea" rows="3" required placeholder={t.ph_pedido}></textarea>
              </div>
            </div>
          </fieldset>

          <div class="reclamos-wizard-nav">
            <button type="button" class="reclamos-btn-prev" data-prev="2">
              <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
              <span>{t.btn_anterior}</span>
            </button>
            <button type="button" class="reclamos-btn-next" data-next="4">
              <span>{t.btn_siguiente}</span>
              <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
            </button>
          </div>
        </div>

        <div class="reclamos-step-panel" data-step="4">
          <fieldset class="reclamos-step-fieldset">
            <legend class="reclamos-step-legend">
              <i class="fa-solid fa-stamp" aria-hidden="true"></i>
              <span>{t.paso4_tit}</span>
            </legend>

            <div class="reclamos-resumen-grid" id="recResumenGrid"></div>

            <div class="acercas-form-grid">
              <div class="acercas-field is-full">
                <label class="reclamos-check-row" for="recDeclaracion">
                  <input id="recDeclaracion" name="declaracion" type="checkbox" required />
                  <span>{t.chk_declaracion}</span>
                </label>
              </div>
            </div>
          </fieldset>

          <div class="reclamos-wizard-nav">
            <button type="button" class="reclamos-btn-prev" data-prev="3">
              <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
              <span>{t.btn_anterior}</span>
            </button>
            <button type="submit" id="recBtnSubmit" class="acercas-submit-btn">
              <i class="fa-solid fa-paper-plane" aria-hidden="true"></i>
              <span>{t.btn_enviar}</span>
            </button>
          </div>
        </div>
      </form>

      <div class="reclamos-step-panel" data-step="5">
        <div id="reclamosSuccessBox" class="acercas-success-box is-visible" aria-live="polite">
          <div class="acercas-success-icon">
            <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
          </div>
          <h2>{t.exito_tit}</h2>
          <p>{t.exito_desc}</p>
          <div class="acercas-success-code">
            <span>{t.exito_cod}</span> <strong id="recCodigoFinal"></strong>
          </div>
          <div class="reclamos-success-actions">
            <button type="button" id="btnImprimirReclamo" class="acercas-print-btn">
              <i class="fa-solid fa-print" aria-hidden="true"></i>
              <span>{t.btn_imprimir}</span>
            </button>
            <a id="recBtnWa" class="acercas-wa-btn" target="_blank" rel="noopener noreferrer">
              <i class="fa-brands fa-whatsapp" aria-hidden="true"></i>
              <span>{t.btn_wa}</span>
            </a>
            <button type="button" id="btnNuevoReclamo" class="acercas-reset-btn">
              <i class="fa-solid fa-rotate-right" aria-hidden="true"></i>
              <span>{t.btn_nuevo}</span>
            </button>
          </div>
        </div>
      </div>
    </div>

    {faqItems.length > 0 && (
      <section class="reclamos-faq-wrap" aria-label={t.faq_tit}>
        <h2 class="reclamos-faq-title">
          <i class="fa-solid fa-circle-question" aria-hidden="true"></i>
          <span>{t.faq_tit}</span>
        </h2>
        <div class="reclamos-faq-list">
          {faqItems.map((item: any, idx: number) => (
            <details class="reclamos-faq-item" open={idx === 0}>
              <summary>
                <span>{item.q}</span>
                <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
              </summary>
              <p class="reclamos-faq-ans">{(item.a || '').replace('{correo}', correo)}</p>
            </details>
          ))}
        </div>
      </section>
    )}
  </div>
</section>

<script>
  import './acercasPage.js';
</script>
