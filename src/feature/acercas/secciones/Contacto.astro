---
// src/feature/acercas/secciones/Contacto.astro
// 📬 Centro de Contacto Directo (0 imágenes · Cascada Sagrada · .conwii 85vw)

import { getFeatureLang, buildRuta, langPrincipal, type Idioma } from '@idioma';
import { WII_INFO, rellenarWii } from '../lib/wiiVars';

interface Props {
  idioma?: Idioma;
}

const { idioma = langPrincipal } = Astro.props;
const locales = import.meta.glob<Record<string, any>>('../idioma/*.json', {
  eager: true,
  import: 'default'
});
const t = rellenarWii(getFeatureLang(locales, idioma).contacto || {});

const correo = WII_INFO.correo;
const desc = t.desc || '';
---

<section class="acercas-page-wrap" aria-label={t.page_title || 'Contacto'}>
  <div class="conwii">
    <header class="acercas-hero-header">
      {t.badge && <div class="acercas-badge-pill">{t.badge}</div>}
      <h1 class="acercas-hero-title">
        {t.titulo_start} {t.titulo_highlight && <span>{t.titulo_highlight}</span>}
      </h1>
      {desc && <p class="acercas-hero-desc">{desc}</p>}
    </header>

    <div class="contacto-channels-grid">
      <article class="contacto-channel-card">
        <span class="legal-clause-icon" aria-hidden="true"><i class="fa-solid fa-globe"></i></span>
        <h2>{t.card_wa_tit}</h2>
        <p>{WII_INFO.linkweb}</p>
        <a href={WII_INFO.linkweb} target="_blank" rel="noopener noreferrer" class="contacto-channel-link">
          <span>{t.card_wa_btn}</span>
          <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
        </a>
      </article>

      <article class="contacto-channel-card">
        <span class="legal-clause-icon" aria-hidden="true"><i class="fa-solid fa-envelope"></i></span>
        <h2>{t.card_mail_tit}</h2>
        <p>{correo}</p>
        <a href={`mailto:${correo}`} class="contacto-channel-link">
          <span>{t.card_mail_btn}</span>
          <i class="fa-solid fa-paper-plane" aria-hidden="true"></i>
        </a>
      </article>

      <article class="contacto-channel-card">
        <span class="legal-clause-icon" aria-hidden="true"><i class="fa-solid fa-code"></i></span>
        <h2>{t.card_sede_tit}</h2>
        <p>{WII_INFO.by}</p>
        <a href={buildRuta('/', idioma)} class="contacto-channel-link" data-astro-prefetch="hover">
          <span>{t.card_sede_btn}</span>
          <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
        </a>
      </article>

      <article class="contacto-channel-card">
        <span class="legal-clause-icon" aria-hidden="true"><i class="fa-solid fa-bolt"></i></span>
        <h2>{t.card_plat_tit}</h2>
        <p>v{WII_INFO.version} · {WII_INFO.slogan}</p>
      </article>
    </div>

    <div class="acercas-form-card">
      <div class="contacto-form-head">
        <h2>{t.form_tit}</h2>
        <p>{t.form_desc}</p>
      </div>

      <form id="formContactoDirecto" class="acercas-form-grid">
        <div class="acercas-field">
          <label for="cntNombre">{t.lbl_nombre}</label>
          <input id="cntNombre" name="nombre" class="acercas-input" type="text" required placeholder={t.ph_nombre} />
        </div>

        <div class="acercas-field">
          <label for="cntCorreo">{t.lbl_correo}</label>
          <input id="cntCorreo" name="correo" class="acercas-input" type="email" required placeholder={t.ph_correo} />
        </div>

        <div class="acercas-field is-full">
          <label for="cntAsunto">{t.lbl_asunto}</label>
          <input id="cntAsunto" name="asunto" class="acercas-input" type="text" required placeholder={t.ph_asunto} />
        </div>

        <div class="acercas-field is-full">
          <label for="cntMensaje">{t.lbl_mensaje}</label>
          <textarea id="cntMensaje" name="mensaje" class="acercas-textarea" rows="4" required placeholder={t.ph_mensaje}></textarea>
        </div>

        <input type="text" name="website" tabindex="-1" autocomplete="off" style="display:none" aria-hidden="true" />

        <div class="acercas-field is-full">
          <button type="submit" id="cntBtnSubmit" class="acercas-submit-btn">
            <i class="fa-solid fa-paper-plane" aria-hidden="true"></i>
            <span>{t.btn_enviar}</span>
          </button>
        </div>
      </form>

      <div id="contactoSuccessBox" class="acercas-success-box" aria-live="polite">
        <div class="acercas-success-icon">
          <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
        </div>
        <h2>{t.exito_tit}</h2>
        <p>{t.exito_desc}</p>
        <button type="button" id="btnNuevoContacto" class="acercas-reset-btn">
          <i class="fa-solid fa-rotate-right" aria-hidden="true"></i>
          <span>{t.btn_nuevo}</span>
        </button>
      </div>
    </div>
  </div>
</section>
