---
// src/feature/seo-test/componentes/SeoMetaPanel.astro
interface Props {
  t: Record<string, any>;
}

const { t } = Astro.props;
---

<div id="dvSeo_simPane" class="dv-seo-wrap dv-seo-hidden">
  <article class="dv-card dv-seo-welcome" id="dvSeo_mejEmpty">
    <div class="dv-seo-welcome-box">
      <span class="dv-seo-welcome-ico"><i class="fa-solid fa-wand-magic-sparkles"></i></span>
      <h2>{t.modeSim}</h2>
      <p>{t.mejorasEmpty}</p>
    </div>
  </article>

  <div class="dv-grid dv-grid-2 dv-seo-grid dv-seo-hidden" id="dvSeo_mejGrid">
    <article class="dv-card dv-seo-panel">
      <div class="dv-seo-label-row">
        <span>{t.mejorasTitle}</span>
        <span class="dv-pill-status" id="dvSeo_mejBadge" data-state="ok">--</span>
      </div>

      <div class="dv-seo-checks dv-seo-audits-scroll" id="dvSeo_mejList"></div>
    </article>

    <article class="dv-card dv-seo-panel">
      <div class="dv-seo-code-head">
        <div class="dv-seo-tabs">
          <button type="button" class="dv-seo-tab active" data-seo-tab="json">{t.tabJson}</button>
          <button type="button" class="dv-seo-tab" data-seo-tab="meta">{t.tabMeta}</button>
          <button type="button" class="dv-seo-tab" data-seo-tab="headers">{t.tabHeaders}</button>
        </div>
        <button type="button" class="dv-btn dv-btn-primary dv-btn-sm" id="dvSeo_btnCopy">
          <i class="fa-regular fa-copy"></i>
          <span>{t.copyBtn}</span>
        </button>
      </div>

      <pre class="dv-seo-pre dv-seo-audits-scroll" id="dvSeo_codeOut"></pre>
    </article>
  </div>
</div>
