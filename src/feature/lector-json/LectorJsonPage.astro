---
// src/feature/lector-json/LectorJsonPage.astro
import './lector-json.css';
import { getFeatureLang, langPrincipal, type Idioma } from '@idioma';
import { SAMPLE_JSON } from './lib/jsonTree.js';

interface Props {
  idioma?: Idioma;
}

const { idioma = langPrincipal } = Astro.props;
const locales = import.meta.glob<Record<string, any>>('./idioma/*.json', {
  eager: true,
  import: 'default'
});
const t = getFeatureLang(locales, idioma);

const i18nPayload = JSON.stringify({
  valid: t.badgeValid,
  invalid: t.badgeInvalid,
  copied: t.copiedMsg,
  pathCopied: t.pathCopied,
  keys: t.keys,
  nodes: t.nodes,
  emptyTree: t.emptyTree
});
---

<section class="dv-json-wrap" id="dvJsonView" data-i18n-msg={i18nPayload}>
  <article class="dv-card">
    <header class="dv-card-head">
      <div class="dv-card-title">
        <span class="dv-card-ico"><i class="fa-solid fa-code"></i></span>
        <div>
          <h1 class="dv-json-title">
            {t.titleStart}<span class="dv-json-grad">{t.titleAccent}</span> {t.titleRest}
          </h1>
          <p class="dv-json-sub">{t.sub}</p>
        </div>
      </div>
      <span class="dv-pill-status" id="dvJson_badge" data-state="ok">{t.badgeValid}</span>
    </header>
  </article>

  <div class="dv-grid dv-grid-2 dv-json-grid">
    <article class="dv-card dv-json-panel">
      <div class="dv-json-toolbar">
        <div class="dv-json-btns">
          <button type="button" class="dv-btn dv-btn-sm" id="dvJson_btnUpload">
            <i class="fa-solid fa-upload"></i>
            <span>{t.uploadBtn}</span>
          </button>
          <input type="file" id="dvJson_fileInput" accept=".json,application/json" hidden />
          <button type="button" class="dv-btn dv-btn-sm" id="dvJson_btnFormat">
            <i class="fa-solid fa-align-left"></i>
            <span>{t.formatBtn}</span>
          </button>
          <button type="button" class="dv-btn dv-btn-sm" id="dvJson_btnMinify">
            <i class="fa-solid fa-compress"></i>
            <span>{t.minifyBtn}</span>
          </button>
          <button type="button" class="dv-btn dv-btn-sm" id="dvJson_btnSample">
            <i class="fa-solid fa-flask"></i>
            <span>{t.sampleBtn}</span>
          </button>
          <button type="button" class="dv-btn dv-btn-sm" id="dvJson_btnClear">
            <i class="fa-solid fa-broom"></i>
            <span>{t.clearBtn}</span>
          </button>
        </div>
        <button type="button" class="dv-btn dv-btn-primary dv-btn-sm" id="dvJson_btnCopy">
          <i class="fa-regular fa-copy"></i>
          <span>{t.copyBtn}</span>
        </button>
      </div>

      <textarea id="dvJson_editor" class="dv-textarea dv-json-editor" spellcheck="false">{SAMPLE_JSON}</textarea>
      <div id="dvJson_errorBox" class="dv-json-error dv-json-hidden"></div>
    </article>

    <article class="dv-card dv-json-panel">
      <div class="dv-json-toolbar">
        <input
          id="dvJson_search"
          type="search"
          class="dv-input dv-json-search"
          placeholder={t.searchPlaceholder}
          autocomplete="off"
        />
        <div class="dv-json-btns">
          <button type="button" class="dv-btn dv-btn-sm" id="dvJson_btnExpand">
            <i class="fa-solid fa-up-right-and-down-left-from-center"></i>
            <span>{t.expandAll}</span>
          </button>
          <button type="button" class="dv-btn dv-btn-sm" id="dvJson_btnCollapse">
            <i class="fa-solid fa-down-left-and-up-right-to-center"></i>
            <span>{t.collapseAll}</span>
          </button>
        </div>
      </div>

      <div id="dvJson_tree" class="dv-json-tree-box"></div>
      <div id="dvJson_stats" class="dv-json-stats"></div>
    </article>
  </div>
</section>
