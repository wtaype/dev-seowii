---
// src/feature/speed-test/SpeedTestPage.astro
import './speed-test.css';
import { getFeatureLang, buildRuta, langPrincipal, type Idioma } from '@idioma';

interface Props {
  idioma?: Idioma;
}

const { idioma = langPrincipal } = Astro.props;
const locales = import.meta.glob<Record<string, any>>('./idioma/*.json', {
  eager: true,
  import: 'default'
});
const t = getFeatureLang(locales, idioma);

const i18nPayload = JSON.stringify({
  idioma,
  runBtn: t.runBtn,
  runningBtn: t.runningBtn,
  oppsAllOk: t.oppsAllOk,
  gaugePerfect: t.gaugePerfect,
  gaugeWarn: t.gaugeWarn,
  gaugeBad: t.gaugeBad,
  progressSteps: t.progressSteps,
  rateLimitMsg: t.rateLimitMsg,
  errGeneric: t.errGeneric,
  emptyMsg: t.emptyMsg
});
---

<section class="dv-spd-wrap" id="dvSpeedView" data-i18n-msg={i18nPayload}>
  <article class="dv-card">
    <header class="dv-card-head">
      <div class="dv-card-title">
        <span class="dv-card-ico"><i class="fa-solid fa-gauge-high"></i></span>
        <div>
          <h1 class="dv-spd-title">
            {t.titleStart}<span class="dv-spd-grad">{t.titleAccent}</span> {t.titleRest}
          </h1>
          <p class="dv-spd-sub">{t.sub}</p>
        </div>
      </div>
      <div class="dv-spd-tabs">
        <a href={buildRuta('/ajustes', idioma)} class="dv-spd-tab" data-astro-prefetch="hover">
          <i class="fa-solid fa-sliders"></i>
          <span>{t.settingsLink}</span>
        </a>
      </div>
    </header>

    <div class="dv-spd-urlbar">
      <input
        id="dvSpd_url"
        type="url"
        class="dv-input"
        value="https://seowii.com"
        placeholder={t.urlPlaceholder}
      />
      <button type="button" class="dv-btn dv-btn-primary" id="dvSpd_btnRun">
        <i class="fa-solid fa-bolt"></i>
        <span>{t.runBtn}</span>
      </button>
    </div>

    <div class="dv-seo-progress dv-spd-hidden" id="dvSpd_progressBox">
      <div class="dv-seo-progress-head">
        <span id="dvSpd_progressTxt">{t.progressSteps?.[0]}</span>
        <strong id="dvSpd_progressPct">0%</strong>
      </div>
      <div class="dv-seo-progress-track">
        <div class="dv-seo-progress-fill" id="dvSpd_progressFill"></div>
      </div>
      <div class="dv-prog-lines">
        {(t.progressSteps || []).map((step: string, i: number) => (
          <span class="dv-prog-line" data-spd-step={i}>{step}</span>
        ))}
      </div>
    </div>

    <div id="dvSpd_err" class="dv-aj-status dv-spd-hidden" data-state="err"></div>
  </article>

  <article class="dv-card dv-seo-welcome" id="dvSpd_welcomeCard">
    <div class="dv-seo-welcome-box">
      <span class="dv-seo-welcome-ico"><i class="fa-solid fa-gauge-high"></i></span>
      <h2>{t.welcomeTitle}</h2>
      <p>{t.welcomeSub}</p>
      <div class="dv-seo-welcome-tags">
        <span class="dv-pill-status">{t.welcomeTag1}</span>
        <span class="dv-pill-status">{t.welcomeTag2}</span>
        <span class="dv-pill-status">{t.welcomeTag3}</span>
      </div>
    </div>
  </article>

  <div class="dv-grid dv-grid-2 dv-spd-hidden" id="dvSpd_resultsGrid">
    <article class="dv-card">
      <div class="dv-seo-label-row">
        <span>{t.vitalsTitle}</span>
      </div>
      <div class="dv-spd-vitals" id="dvSpd_vitals"></div>

      <div class="dv-seo-label-row">
        <span>{t.diagTitle}</span>
      </div>
      <div class="dv-spd-vitals" id="dvSpd_diags"></div>

      <div class="dv-seo-label-row">
        <span>{t.oppsTitle}</span>
        <span class="dv-pill-status" id="dvSpd_oppsCount">0</span>
      </div>
      <div class="dv-spd-opps dv-spd-opps-scroll" id="dvSpd_opps"></div>
    </article>

    <article class="dv-card">
      <div class="dv-seo-label-row">
        <span>{t.shotTitle}</span>
        <div class="dv-spd-tabs">
          <button type="button" class="dv-spd-tab active" data-spd-strat="mobile">
            <i class="fa-solid fa-mobile-screen-button"></i> {t.mobile}
          </button>
          <button type="button" class="dv-spd-tab" data-spd-strat="desktop">
            <i class="fa-solid fa-desktop"></i> {t.desktop}
          </button>
          <button type="button" class="dv-spd-tab" id="dvSpd_btnSaveJson" disabled>
            <i class="fa-solid fa-download"></i> JSON
          </button>
        </div>
      </div>

      <div class="dv-spd-shot-box" id="dvSpd_shotBox"></div>

      <div class="dv-spd-scores">
        <div class="dv-spd-kpi" id="dvSpd_kpiPerf" data-state="ok">
          <strong id="dvSpd_valPerf">--</strong>
          <span>Performance</span>
        </div>
        <div class="dv-spd-kpi" id="dvSpd_kpiA11y" data-state="ok">
          <strong id="dvSpd_valA11y">--</strong>
          <span>Accessibility</span>
        </div>
        <div class="dv-spd-kpi" id="dvSpd_kpiBp" data-state="ok">
          <strong id="dvSpd_valBp">--</strong>
          <span>Best Practices</span>
        </div>
        <div class="dv-spd-kpi" id="dvSpd_kpiSeo" data-state="ok">
          <strong id="dvSpd_valSeo">--</strong>
          <span>SEO</span>
        </div>
      </div>

      <div class="dv-gauge-wrap">
        <div class="dv-gauge-box">
          <svg class="dv-gauge-svg" viewBox="0 0 200 115" aria-hidden="true">
            <defs>
              <linearGradient id="dvSpdGaugeGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                <stop offset="0%" stop-color="var(--error)" />
                <stop offset="50%" stop-color="var(--warning)" />
                <stop offset="100%" stop-color="var(--success)" />
              </linearGradient>
            </defs>
            <path d="M 20 100 A 80 80 0 0 1 180 100" fill="none" stroke="var(--bg3)" stroke-width="14" stroke-linecap="round" />
            <path d="M 20 100 A 80 80 0 0 1 180 100" fill="none" stroke="url(#dvSpdGaugeGrad)" stroke-width="14" stroke-linecap="round" />
            <g class="dv-gauge-needle" id="dvSpd_needle" style="transform: rotate(-90deg);">
              <line x1="100" y1="100" x2="100" y2="30" stroke="var(--primary)" stroke-width="3.5" stroke-linecap="round" />
              <circle cx="100" cy="100" r="6" fill="var(--primary)" />
            </g>
          </svg>
          <div class="dv-gauge-score" id="dvSpd_gaugeScore">--</div>
          <span class="dv-pill-status" id="dvSpd_gaugeBadge" data-state="ok">Performance</span>
        </div>

        <div class="dv-gauge-bars">
          <div class="dv-gbar-item">
            <div class="dv-gbar-head"><span>Performance</span><strong id="dvSpd_barTxtPerf">--</strong></div>
            <div class="dv-gbar-track"><div class="dv-gbar-fill" id="dvSpd_barPerf" style="width:0%"></div></div>
          </div>
          <div class="dv-gbar-item">
            <div class="dv-gbar-head"><span>Accessibility</span><strong id="dvSpd_barTxtA11y">--</strong></div>
            <div class="dv-gbar-track"><div class="dv-gbar-fill" id="dvSpd_barA11y" style="width:0%"></div></div>
          </div>
          <div class="dv-gbar-item">
            <div class="dv-gbar-head"><span>Best Practices</span><strong id="dvSpd_barTxtBp">--</strong></div>
            <div class="dv-gbar-track"><div class="dv-gbar-fill" id="dvSpd_barBp" style="width:0%"></div></div>
          </div>
          <div class="dv-gbar-item">
            <div class="dv-gbar-head"><span>SEO</span><strong id="dvSpd_barTxtSeo">--</strong></div>
            <div class="dv-gbar-track"><div class="dv-gbar-fill" id="dvSpd_barSeo" style="width:0%"></div></div>
          </div>
        </div>
      </div>
    </article>
  </div>
</section>
