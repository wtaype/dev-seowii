---
// src/core/componentes/Mobile.astro
import { configurar } from '@semillas';
import { getCoreLang, buildRuta, langPrincipal, type Idioma } from '@idioma';

interface Props {
  idioma?: Idioma;
}

const { idioma = langPrincipal } = Astro.props;
const IDS_MOBILE = new Set(['general', 'imgwii', 'seo-test', 'speed-test']);
const navMobile = configurar.navPrincipal.filter((item) => IDS_MOBILE.has(item.id));
const t = getCoreLang(idioma);
---

<header class="dv-mob-header" id="dvMobHeader" transition:persist="dv-mob-header">
  <a href={buildRuta('/', idioma)} class="dv-mob-brand" data-nav-link data-base-href="/" data-astro-prefetch="hover">
    <span class="dv-mob-logo"><i class="fa-solid fa-terminal"></i></span>
    <span class="dv-mob-brand-txt">
      <strong>{configurar.app}</strong>
      <small>{configurar.slogan}</small>
    </span>
  </a>

  <div class="dv-mob-actions">
    <button id="dvMob_idioma" type="button" class="dv-mob-act-btn" data-action="toggle-idioma" aria-label="Idioma">
      <i class="fa-solid fa-globe"></i>
      <span data-i18n-lang-short>{idioma.toUpperCase()}</span>
    </button>
    <button id="dvMob_tema" type="button" class="dv-mob-act-btn" data-action="toggle-tema" aria-label="Tema">
      <i class="fa-solid fa-moon" data-tema-ico="1"></i>
    </button>
    <a
      id="dvMob_ajustes"
      href={buildRuta('/ajustes', idioma)}
      class="dv-mob-act-btn"
      data-nav-link
      data-base-href="/ajustes"
      data-astro-prefetch="hover"
      aria-label="Ajustes"
    >
      <i class="fa-solid fa-gear"></i>
    </a>
  </div>
</header>

<nav class="dv-mobile" id="dvMobile" transition:persist="dv-mobile" aria-label="Navegación móvil">
  {navMobile.map((item) => {
    const label = t.nav?.[item.id]?.label || '';
    return (
      <a
        id={`dvMob_${item.id}`}
        href={buildRuta(item.href, idioma)}
        class="dv-mob-item"
        data-nav-link
        data-base-href={item.href}
        data-astro-prefetch="hover"
      >
        <i class={item.icono}></i>
        <span data-i18n-nav={item.id}>{label}</span>
      </a>
    );
  })}
  <a
    id="dvMob_mas"
    href={buildRuta('/mas', idioma)}
    class="dv-mob-item"
    data-nav-link
    data-base-href="/mas"
    data-astro-prefetch="hover"
  >
    <i class="fa-solid fa-grip"></i>
    <span data-i18n-util="mas">{t.util?.mas}</span>
  </a>
</nav>
