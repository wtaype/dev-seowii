---
// src/core/componentes/Acerca.astro
import { configurar } from '@semillas';
import { getCoreLang, langPrincipal, type Idioma } from '@idioma';

interface Props {
  idioma?: Idioma;
}

const { idioma = langPrincipal } = Astro.props;
const { app, slogan, by, version, enlacesAcerca } = configurar;
const t = getCoreLang(idioma);
---

<div class="dv-modal-backdrop" id="dvModalAcerca" hidden aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="dvAcercaTitle">
  <div class="dv-modal-card">
    <header class="dv-modal-head">
      <div class="dv-modal-brand">
        <span class="dv-modal-ico"><i class="fa-solid fa-terminal"></i></span>
        <div>
          <h2 id="dvAcercaTitle">{app}</h2>
          <p>{slogan} · v{version} · {by}</p>
        </div>
      </div>
      <button id="dvAcerca_close" type="button" class="dv-modal-close" data-action="close-acerca" aria-label="Cerrar">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </header>

    <p class="dv-modal-desc" data-i18n-acerca="descripcion">{t.acerca?.descripcion}</p>

    <div class="dv-modal-links">
      {enlacesAcerca.map((link) => (
        <a id={`dvAcerca_${link.id}`} href={link.href} class="dv-modal-pill" data-action="close-acerca">
          <i class={link.icono}></i>
          <span data-i18n-acerca-link={link.id}>{t.acerca?.enlaces?.[link.id] || link.id}</span>
        </a>
      ))}
    </div>
  </div>
</div>
